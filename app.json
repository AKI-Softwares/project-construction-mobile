{
  "expo": {
    "name": "CheckObra",
    "slug": "project-construction-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "checkobra",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1520"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.checkobra.mobile",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "br.com.checkobra.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image-picker",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9f586cb9-d3a2-4c47-9572-752fcda196e5"
      }
    }
  }
}
