{
  "expo": {
    "name": "CheckObra",
    "slug": "project-construction-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "checkobra",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0F1520"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.checkobra.mobile"
    },
    "android": {
      "package": "br.com.checkobra.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image-picker",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
